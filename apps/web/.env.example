# ---- Public (exposed to browser, baked at build time) ----
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_FULLNODE_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_GRAPHQL_URL=https://sui-testnet.mystenlabs.com/graphql
NEXT_PUBLIC_PROVER_URL=https://prover-dev.mystenlabs.com/v1
# Optional: defaults to /api/salt (server-side proxy to bypass CORS).
# Override only if you have your own browser-CORS-enabled salt endpoint.
# NEXT_PUBLIC_SALT_URL=

# ---- Server-side only (NEVER prefix with NEXT_PUBLIC_) ----
ADMIN_CAP_ID=0x4d1d37126c269607f786ff5769e581df8f63b0195429a0a545d39e07bed2e788
ADMIN_PRIVATE_KEY_BECH32=
